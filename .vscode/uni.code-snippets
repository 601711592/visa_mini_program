{
  // Place your 21_11_jixiang_uniapp 工作区 snippets here. Each snippet is defined under a snippet name and has a scope, prefix, body and
  // description. Add comma separated ids of the languages where the snippet is applicable in the scope field. If scope
  // is left empty or omitted, the snippet gets applied to all languages. The prefix is what is
  // used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
  // $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders.
  // Placeholders with the same ids are connected.
  // Example:
  // "Print to console": {
  // 	"scope": "javascript,typescript",
  // 	"prefix": "log",
  // 	"body": [
  // 		"console.log('$1');",
  // 		"$2"
  // 	],
  // 	"description": "Log output to console"
  // }
  "tabs": {
    "prefix": "tabs",
    "body": [
      "<view class=\"tabs\">",
      "  <view",
      "    class=\"item\"",
      "    v-for=\"(item, index) in $1\"",
      "    :key=\"index\"",
      "    :class=\"{ active: currentTab === index }\"",
      "    @click=\"currentTab = index\"",
      "    >{{ item }}</view",
      "  >",
      "</view>"
    ],
    "description": "tabs"
  },
  "style background image": { "prefix": ":sb", "body": [":style=\"`background-image:url(${$1})`\""], "description": "样式背景图片" },
  "d-icon": { "prefix": "dicon", "body": ["<d-icon type=\"forward\" size=\"18rpx\" color=\"#000000\" dclass=\"ml24\"></d-icon>"], "description": "图标组件" },
  "eventChannel": { "prefix": "eventChannel", "body": ["const eventChannel = getOpenerEventChannel();"], "description": "事件渠道" },
  "iconfont": {
		"prefix": "iconfont",
		"body": [
			"<iconfont type=\"$1\" size=\"12\" color=\"rgba(0, 0, 0, 0.90)\" />"
		],
		"description": "快速生成iconfont"
	},
